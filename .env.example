# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_BACKUP_API_KEY: Optional backup Gemini API key used automatically if the primary key exceeds quota (429 / RESOURCE_EXHAUSTED) or encounters errors.
GEMINI_BACKUP_API_KEY=""

# POLLINATIONS_API_KEY: Optional/Default API key for Pollinations AI vision & scanning.
POLLINATIONS_API_KEY="MY_POLLINATIONS_API_KEY"

# PINTEREST_ACCESS_TOKEN: Required for real Pinterest API integration.
# Configure this in Environment Variables with your Pinterest API token.
# Required scopes: user_accounts:read, boards:read, pins:read, pins:write
PINTEREST_ACCESS_TOKEN="MY_PINTEREST_ACCESS_TOKEN"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
# CUSTOM_AI_API_URL: Optional custom OpenAI-compatible AI API endpoint (e.g., https://api.openai.com/v1/chat/completions or custom proxy)
CUSTOM_AI_API_URL=""

# CUSTOM_AI_API_KEY: Optional Bearer token / API key for the custom AI endpoint
CUSTOM_AI_API_KEY=""

# CUSTOM_AI_MODEL: Optional model identifier for custom AI endpoint (e.g., gpt-4o, claude-3-5-sonnet, deepseek-chat)
CUSTOM_AI_MODEL=""

